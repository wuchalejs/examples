{
	"name": "sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"platest": "echo wuchale @wuchale/svelte",
		"plocal": "echo ../../wuchale/packages/wuchale ../../wuchale/packages/svelte",
		"ilatest": "npm i $(npm run platest --silent)",
		"ilocal": "npm i $(npm run plocal --silent)",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^25.9.5",
		"sass": "^1.104.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@webcontainer/env": "^1.1.1",
		"@wuchale/svelte": "^0.21.3",
		"sv-lib": "file:sv-lib/sv-lib-0.0.1.tgz",
		"wuchale": "^0.26.6"
	}
}
