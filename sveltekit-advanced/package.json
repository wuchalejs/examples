{
	"name": "sveltekit-advanced",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"platest": "echo wuchale @wuchale/svelte",
		"plocal": "echo ../../wuchale/packages/wuchale ../../wuchale/packages/svelte",
		"ilatest": "npm i $(npm run platest --silent)",
		"ilocal": "npm i $(npm run plocal --silent)",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"extract": "wuchale",
		"clean": "wuchale --clean"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.5",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"@webcontainer/env": "^1.1.1",
		"@wuchale/svelte": "^0.21.1",
		"tailwindcss": "^4.3.3",
		"wuchale": "^0.26.4"
	}
}
