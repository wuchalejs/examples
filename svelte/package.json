{
  "name": "svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "platest": "echo wuchale @wuchale/svelte",
    "plocal": "echo ../../wuchale/packages/wuchale ../../wuchale/packages/svelte",
    "ilatest": "npm i $(npm run platest --silent)",
    "ilocal": "npm i $(npm run plocal --silent)",
    "extract": "wuchale",
    "clean": "wuchale --clean"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.56.3",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@wuchale/svelte": "^0.21.4",
    "wuchale": "^0.26.7"
  }
}
